# ImageKit server-side access. Never expose IMAGEKIT_PRIVATE_KEY to the browser.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_NOVEL_PATH=/novels/

# Private ImageKit files require signed delivery URLs. Keep this true for novels.
IMAGEKIT_SIGNED_FILES=true

# Seconds to cache the remote file list and TXT contents in the running server.
IMAGEKIT_CACHE_SECONDS=60
